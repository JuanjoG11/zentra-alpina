# Supabase credentials for loader
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-or-admin-key

# Optional: directory with processed JSON (defaults to ./tmp_processed)
INPUT_DIR=./tmp_processed
\n+# Optional: process server (where /process endpoint is reachable) for backend processing after upload
PROCESS_SERVER_URL=http://localhost:3001
